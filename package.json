{
  "name": "zjh",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "好友炸金花 —— 单进程 Node 服务端权威 + WebSocket 实时推送",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "test": "node --test 'tests/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "cli": "node dist/cli.mjs",
    "mcp": "node dist/mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "bin": {
    "zjh": "dist/cli.mjs",
    "zjh-mcp": "dist/mcp.mjs"
  }
}
